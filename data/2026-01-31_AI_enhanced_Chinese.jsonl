e2d\u8ba8\u8bba\u805a\u7c7b\u6280\u672f\uff0c\u5e76\u7ed3\u5408\u53ef\u89e3\u91caAI\u3001\u81ea\u52a8\u673a\u5668\u5b66\u4e60\u548c\u8054\u90a6\u5b66\u4e60\u7b49\u65b9\u5411\u8fdb\u884c\u5206\u6790\u4e0e\u63a2\u8ba8\u3002", "result": "\u805a\u7c7b\u6280\u672f\u88ab\u8bc1\u660e\u4e0d\u4ec5\u80fd\u591f\u652f\u6301\u5b66\u672f\u5b66\u4e60\uff0c\u8fd8\u80fd\u6709\u6548\u5e94\u7528\u4e8e\u53ef\u89e3\u91caAI\u3001\u81ea\u52a8\u673a\u5668\u5b66\u4e60\u548c\u8054\u90a6\u5b66\u4e60\u7b49\u524d\u6cbf\u9886\u57df\u3002", "conclusion": "\u805a\u7c7b\u6280\u672f\u5728\u65e0\u76d1\u7763\u5b66\u4e60\u53ca\u76f8\u5173\u65b0\u5174AI\u9886\u57df\u4e2d\u5177\u6709\u5e7f\u6cdb\u9002\u7528\u6027\u548c\u91cd\u8981\u7814\u7a76\u4ef7\u503c\uff0c\u503c\u5f97\u8fdb\u4e00\u6b65\u6df1\u5165\u63a2\u7d22\u3002"}}
{"id": "scholar_9b06787b4420f9298e9aaef037b00b1a", "title": "Beschleunigung und Qualit\u00e4tsverbesserung der Zellformierung durch datenreiche elektrochemische Protokolle", "authors": ["LM Merker"], "summary": "\u2026 learning and transfer learning models. Subsequently, conducting additional tests on other materials would strengthen the results and be interesting for research. By the time this work was created, a project involving the active learning \u2026 fidelity data \u2026", "categories": ["learned \"cost model\""], "pdf": "https://scholar.google.com/scholar_url?url=https://mediatum.ub.tum.de/doc/1832105/document.pdf&hl=zh-CN&sa=X&d=3394734550055364468&ei=PpJ8adTjJpuk6rQP-8WmkAM&scisig=AHkA5jR1u1AKXeetRZPn3ltg3wP9&oi=scholaralrt&hist=Pxo5FIAAAAAJ:15658717702251462117:AHkA5jRs58Sh7gAGjO8tMulsiOso&html=&pos=8&folt=kw-top", "abs": "https://scholar.google.com/scholar_url?url=https://mediatum.ub.tum.de/doc/1832105/document.pdf&hl=zh-CN&sa=X&d=3394734550055364468&ei=PpJ8adTjJpuk6rQP-8WmkAM&scisig=AHkA5jR1u1AKXeetRZPn3ltg3wP9&oi=scholaralrt&hist=Pxo5FIAAAAAJ:15658717702251462117:AHkA5jRs58Sh7gAGjO8tMulsiOso&html=&pos=8&folt=kw-top", "comment": "From Google Scholar Alert", "source": "Google Scholar", "AI": {"tldr": "\u8be5\u8bba\u6587\u63a2\u8ba8\u4e86\u4e3b\u52a8\u5b66\u4e60\u4e0e\u8fc1\u79fb\u5b66\u4e60\u6a21\u578b\uff0c\u5e76\u5efa\u8bae\u901a\u8fc7\u5728\u5176\u4ed6\u6750\u6599\u4e0a\u8fdb\u884c\u989d\u5916\u6d4b\u8bd5\u6765\u589e\u5f3a\u7ed3\u679c\u3002", "motivation": "\u63d0\u5347\u6a21\u578b\u5728\u4e0d\u540c\u6750\u6599\u4e0a\u7684\u6cdb\u5316\u80fd\u529b\uff0c\u5e76\u9a8c\u8bc1\u4e3b\u52a8\u5b66\u4e60\u4e0e\u8fc1\u79fb\u5b66\u4e60\u5728\u9ad8\u4fdd\u771f\u6570\u636e\u73af\u5883\u4e0b\u7684\u6709\u6548\u6027\u3002", "method": "\u7ed3\u5408\u4e3b\u52a8\u5b66\u4e60\u4e0e\u8fc1\u79fb\u5b66\u4e60\u65b9\u6cd5\uff0c\u5229\u7528\u9ad8\u4fdd\u771f\u6570\u636e\u8fdb\u884c\u6a21\u578b\u8bad\u7ec3\u4e0e\u8bc4\u4f30\u3002", "result": "\u521d\u6b65\u7ed3\u679c\u8868\u660e\u6240\u63d0\u65b9\u6cd5\u5177\u6709\u6f5c\u529b\uff0c\u4f46\u9700\u8fdb\u4e00\u6b65\u5728\u5176\u4ed6\u6750\u6599\u4e0a\u9a8c\u8bc1\u4ee5\u589e\u5f3a\u7ed3\u8bba\u7684\u53ef\u9760\u6027\u3002", "conclusion": "\u4e3b\u52a8\u5b66\u4e60\u4e0e\u8fc1\u79fb\u5b66\u4e60\u5728\u6750\u6599\u7814\u7a76\u4e2d\u5177\u6709\u5e94\u7528\u524d\u666f\uff0c\u672a\u6765\u5de5\u4f5c\u5e94\u6269\u5c55\u81f3\u66f4\u591a\u6750\u6599\u4ee5\u9a8c\u8bc1\u5176\u666e\u9002\u6027\u3002"}}
{"id": "scholar_d533aacf41637fa146c0a87cbb02abca", "title": "Markovian Pre-Trained Transformer for Next-Item Recommendation", "authors": ["C Xu", "G Li", "J Wang", "W Zhang"], "summary": "We introduce the Markovian Pre-trained Transformer (MPT) for next-item recommendation, a transferable model fully pre-trained on synthetic Markov chains, yet capable of achieving state-of-the-art performance by fine-tuning a lightweight \u2026", "categories": ["Ziniu Wu"], "pdf": "https://scholar.google.com/scholar_url?url=https://arxiv.org/pdf/2601.08275&hl=zh-CN&sa=X&d=4748469596494327208&ei=0j99aYOgCOyj6rQPgIvEoAQ&scisig=AHkA5jSFQdKBtVneTXYrtYrgD9ma&oi=scholaralrt&hist=Pxo5FIAAAAAJ:11734074576040036222:AHkA5jT4qH64J8nZejvQlyvZo1xT&html=&pos=1&folt=rel", "abs": "https://scholar.google.com/scholar_url?url=https://arxiv.org/pdf/2601.08275&hl=zh-CN&sa=X&d=4748469596494327208&ei=0j99aYOgCOyj6rQPgIvEoAQ&scisig=AHkA5jSFQdKBtVneTXYrtYrgD9ma&oi=scholaralrt&hist=Pxo5FIAAAAAJ:11734074576040036222:AHkA5jT4qH64J8nZejvQlyvZo1xT&html=&pos=1&folt=rel", "comment": "From Google Scholar Alert", "source": "Google Scholar", "AI": {"tldr": "\u672c\u6587\u63d0\u51fa\u4e86\u9a6c\u5c14\u53ef\u592b\u9884\u8bad\u7ec3Transformer\uff08MPT\uff09\uff0c\u8be5\u6a21\u578b\u5728\u5408\u6210\u9a6c\u5c14\u53ef\u592b\u94fe\u4e0a\u5b8c\u5168\u9884\u8bad\u7ec3\uff0c\u901a\u8fc7\u8f7b\u91cf\u7ea7\u5fae\u8c03\u5373\u53ef\u5728\u4e0b\u4e00\u7269\u54c1\u63a8\u8350\u4efb\u52a1\u4e2d\u8fbe\u5230\u9886\u5148\u6027\u80fd\u3002", "motivation": "\u73b0\u6709\u63a8\u8350\u7cfb\u7edf\u6a21\u578b\u901a\u5e38\u4f9d\u8d56\u5927\u89c4\u6a21\u771f\u5b9e\u7528\u6237\u884c\u4e3a\u6570\u636e\u8fdb\u884c\u9884\u8bad\u7ec3\uff0c\u6210\u672c\u9ad8\u4e14\u6cdb\u5316\u80fd\u529b\u53d7\u9650\u3002\u4f5c\u8005\u65e8\u5728\u6784\u5efa\u4e00\u79cd\u53ef\u8fc1\u79fb\u3001\u65e0\u9700\u771f\u5b9e\u4ea4\u4e92\u6570\u636e\u7684\u9884\u8bad\u7ec3\u8303\u5f0f\uff0c\u4ee5\u63d0\u5347\u6a21\u578b\u7684\u901a\u7528\u6027\u548c\u90e8\u7f72\u6548\u7387\u3002", "method": "\u63d0\u51faMPT\u6a21\u578b\uff0c\u5229\u7528\u5408\u6210\u7684\u9a6c\u5c14\u53ef\u592b\u94fe\u4f5c\u4e3a\u9884\u8bad\u7ec3\u6570\u636e\u6e90\uff0c\u5bf9Transformer\u67b6\u6784\u8fdb\u884c\u5b8c\u5168\u9884\u8bad\u7ec3\uff1b\u5728\u4e0b\u6e38\u4efb\u52a1\u4e2d\u4ec5\u9700\u5fae\u8c03\u5c11\u91cf\u53c2\u6570\u5373\u53ef\u9002\u914d\u5177\u4f53\u63a8\u8350\u573a\u666f\u3002", "result": "MPT\u5728\u591a\u4e2a\u516c\u5f00\u63a8\u8350\u6570\u636e\u96c6\u4e0a\u5fae\u8c03\u540e\uff0c\u6027\u80fd\u4f18\u4e8e\u5f53\u524d\u4e3b\u6d41\u65b9\u6cd5\uff0c\u9a8c\u8bc1\u4e86\u57fa\u4e8e\u5408\u6210\u9a6c\u5c14\u53ef\u592b\u94fe\u9884\u8bad\u7ec3\u7684\u6709\u6548\u6027\u4e0e\u53ef\u8fc1\u79fb\u6027\u3002", "conclusion": "\u8be5\u5de5\u4f5c\u8bc1\u660e\u4e86\u4f7f\u7528\u5408\u6210\u5e8f\u5217\u6570\u636e\u8fdb\u884c\u9884\u8bad\u7ec3\u7684\u53ef\u884c\u6027\uff0c\u4e3a\u964d\u4f4e\u63a8\u8350\u7cfb\u7edf\u5bf9\u771f\u5b9e\u7528\u6237\u6570\u636e\u7684\u4f9d\u8d56\u63d0\u4f9b\u4e86\u65b0\u601d\u8def\uff0c\u5e76\u5c55\u793a\u4e86\u8f7b\u91cf\u5fae\u8c03\u7b56\u7565\u5728\u8de8\u57df\u63a8\u8350\u4e2d\u7684\u6f5c\u529b\u3002"}}
